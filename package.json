{
  "name": "x-anti-slop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/tasarren/x-anti-slop.git" },
  "bugs": { "url": "https://github.com/tasarren/x-anti-slop/issues" },
  "type": "module",
  "description": "Personal regular-expression filters for posts on X.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.ts",
    "test": "npm run build && node scripts/package.ts && node --test tests/check.ts tests/release.ts",
    "preview": "node scripts/preview.ts",
    "package": "npm test && npm run validate:firefox",
    "validate:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "web-ext": "10.6.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
